set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Fast checks: formatting, lints, and the naming rule.
lint:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    uv run --project python ruff check --config python/pyproject.toml python tests
    uv run --project python ruff format --check --config python/pyproject.toml python tests
    @! grep -rnE 'std::(fs|net|thread|process)|time::(Instant|SystemTime)|midir|rusqlite' src/core --include=*.rs --exclude=tests.rs \
        || (echo "src/core must stay free of I/O (see above)"; exit 1)
    @! grep -rIlE --exclude-dir=.git --exclude-dir=target --exclude-dir=.venv --exclude=uv.lock '(^|[^A-Za-z])([N]ora|[n]ora|NOR[A])' . \
        || (echo "forbidden legacy name found (see above)"; exit 1)

fmt:
    cargo fmt
    uv run --project python ruff format --config python/pyproject.toml python tests

# Unit and integration tests that need no MIDI hardware.
test:
    cargo build --examples
    cargo test
    uv run --project python pytest -m "not e2e and not live"

# Black-box suite against the Rust bridge (needs CoreMIDI virtual ports).
e2e:
    cargo build --bin midi-bridge
    BRIDGE_IMPL=rust uv run --project python pytest -m e2e

# Same suite against the original Python bridge: proves the spec itself is valid.
e2e-reference:
    BRIDGE_IMPL=reference uv run --project python pytest -m e2e

# Checks that the real freemidi.org and bitmidi.com pages still match the scraper (needs internet).
live:
    uv run --project python pytest -m live tests/search

# A Windows executable for the machine that runs Unity (needs `brew install mingw-w64`).
build-windows:
    rustup target add x86_64-pc-windows-gnu
    cargo build --release --target x86_64-pc-windows-gnu
